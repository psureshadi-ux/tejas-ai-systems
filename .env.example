# ==============================================================================
# TEJAS AI SYSTEMS - ENVIRONMENT VARIABLES SPECIFICATION
# Use this template for local development (.env.local) and Vercel Production
# DO NOT COMMIT REAL SECRETS OR PRODUCTION VALUES TO SOURCE CONTROL
# ==============================================================================

# Application Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase Managed Database & Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres?sslmode=require"

# Agency Core Settings (Tirupati Operations)
NEXT_PUBLIC_AGENCY_NAME="Tejas AI Systems"
NEXT_PUBLIC_AGENCY_PHONE="+91 98765 43210"
NEXT_PUBLIC_AGENCY_EMAIL="contact@tejasai.in"
NEXT_PUBLIC_AGENCY_LOCATION="Tirupati, Andhra Pradesh, India"
OWNER_ALERT_WHATSAPP="+919876543210"
OWNER_ALERT_EMAIL="founder@tejasai.in"

# Payment Gateway (Razorpay India - UPI / Cards / NetBanking)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Meta WhatsApp Cloud API (Official Platform)
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_token"

# Transactional Email (Resend or SMTP)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Tejas AI Systems <notifications@tejasai.in>"

# AI Model Providers (Server-Side Gateway)
GEMINI_API_KEY="AIzaSy_your_gemini_api_key"
OPENAI_API_KEY="sk-your_openai_api_key"

# Google Calendar Integration (OAuth 2.0 for Appointments)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# Security & Secret Encryption Vault
ENCRYPTION_MASTER_KEY="generate_a_secure_32_byte_hex_key_here"
CRON_SECRET="your_secure_cron_trigger_secret"
